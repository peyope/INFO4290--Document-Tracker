// backend/controllers/adminUserActivityController.js
const pool = require("../config/db"); // adjust path to your db pool

exports.getUserActivity = async (req, res) => {
  try {
    const result = await pool.query(
      `SELECT aua.id,
              aua.action_type,
              aua.details,
              aua.created_at,
              actor.email  AS actor_email,
              target.email AS target_email
       FROM admin_user_activity aua
       LEFT JOIN users actor  ON actor.id  = aua.actor_user_id
       LEFT JOIN users target ON target.id = aua.target_user_id
       ORDER BY aua.created_at DESC
       LIMIT 200`
    );
    res.json(result.rows);
  } catch (err) {
    console.error("getUserActivity error", err);
    res.status(500).json({ message: "Failed to fetch user activity" });
  }
};

// helper used by other controllers
exports.logUserActivity = async (
  actorUserId,
  targetUserId,
  actionType,
  details = null
) => {
  try {
    await pool.query(
      `INSERT INTO admin_user_activity
         (actor_user_id, target_user_id, action_type, details)
       VALUES ($1, $2, $3, $4)`,
      [actorUserId, targetUserId, actionType, details]
    );
  } catch (err) {
    console.error("logUserActivity error", err);
    // don't throw, we don't want to break main action because of logging
  }
};
